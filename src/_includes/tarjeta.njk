{% macro tarjeta(c) %}{% set au = c.data.audio | ivoox %}{% set img = c.data.image or "/img/logo-jesus-es-senor.png" %}
<article class="charla" data-texto="{{ (c.data.title + ' ' + (c.content | textoPlano)) | lower }}">
  <img class="charla__img" src="{{ img }}" alt="" loading="lazy" width="96" height="96">
  <div class="charla__cuerpo">
    <p class="charla__fecha"><time datetime="{{ c.date | isoDate }}">{{ c.date | fecha }}</time></p>
    <h3 class="charla__titulo"><a href="{{ c.url }}">{{ c.data.title }}</a></h3>
    {% if au.mp3 %}<button class="boton-escuchar" data-audio="{{ au.mp3 }}" data-titulo="{{ c.data.title }}" data-img="{{ img }}">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>Escuchar
    </button>{% else %}<a class="boton-escuchar" href="{{ c.url }}">Escuchar</a>{% endif %}
  </div>
</article>
{% endmacro %}
